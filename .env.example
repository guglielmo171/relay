# Required for voice generation. Get one at https://elevenlabs.io
# Server-side only — never expose this to the client.
ELEVENLABS_API_KEY=

# Optional: override the curated default voice with any premade voice ID.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional: require an unlock before generating audio.
# Recommended when deploying anywhere public so strangers can't spend your credits.
# RELAY_APP_SECRET=
